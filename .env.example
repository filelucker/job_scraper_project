# ==========================================
# Telegram Integration Configuration
# ==========================================
# Your Telegram bot token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram channel or chat ID (e.g. -100123456789 or @channelname)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# Google Sheets Integration Configuration
# ==========================================
# The full path to your service_account.json file, or the raw stringified JSON content of the service account key
GOOGLE_CREDENTIALS_JSON=path/to/your/service_account.json

# The name of the Google Spreadsheet to write into (must be shared with the service account email)
GOOGLE_SHEET_NAME="Job Scraper Results"

# The name of the worksheet/tab to write into
GOOGLE_WORKSHEET_NAME="Jobs"

# ==========================================
# Adzuna API Integration Configuration (Free)
# ==========================================
# Register on https://developer.adzuna.com to get these keys instantly
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ==========================================
# Jooble API Integration Configuration (Free)
# ==========================================
# Request a free API key at https://jooble.org/api-key-request
JOOBLE_API_KEY=your_jooble_api_key_here

# ==========================================
# USAJOBS API Integration Configuration
# ==========================================
# Request a free API key at https://developer.usajobs.gov
USAJOBS_API_KEY=your_usajobs_api_key_here

# ==========================================
# Wellfound (Firecrawl) Integration Configuration
# ==========================================
# Request a free API key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==========================================
# Apify API Integration Configuration
# ==========================================
# Obtain your API token from https://console.apify.com/
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LINKEDIN_ACTOR=curious_coder/linkedin-jobs-scraper
APIFY_INDEED_ACTOR=misceres/indeed-scraper
APIFY_LINKEDIN_LOCATION=Remote
APIFY_INDEED_LOCATION=Remote
APIFY_INDEED_COUNTRY=US

# ==========================================
# GermanTechJobs / JobCopilot Configuration
# ==========================================
# Log into https://germantechjobs.de (or devitjobs.jobcopilot.com) with your free account.
# Copy your Cookie string from DevTools (F12 -> Application -> Cookies), or your Bearer token:
GERMANTECHJOBS_COOKIE="your_germantechjobs_session_cookie_here"
# Optional Bearer token if using API token:
JOBCOPILOT_TOKEN=

# ==========================================
# Lookback & Auto-Apply Pipeline
# ==========================================
# Post lookback window in hours (default: 6)
JOB_LOOKBACK_HOURS=6

# Set to true to enable automated resume tailoring & applications
AUTO_APPLY_ENABLED=true

# Options: 'auto' (fully automated submission), 'review' (pre-fills form and saves preview screenshot), 'dry_run'
AUTO_APPLY_MODE=auto
